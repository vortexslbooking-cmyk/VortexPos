# Copia este archivo a ".env" para desarrollo local (o define estas variables
# en el panel de tu proveedor de hosting para producción).

# Base de datos. Desarrollo: SQLite (por defecto). Producción: Postgres.
DATABASE_URL=sqlite:///./vortexpos.db
# Producción (ejemplo Postgres):
# DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/vortexpos

# Clave para firmar los tokens. USA UNA LARGA Y ALEATORIA EN PRODUCCIÓN (32+ caracteres).
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-de-32-o-mas-caracteres

# Credenciales del panel de proveedor (solo tú).
PROVIDER_EMAIL=admin@vortexpos.local
PROVIDER_PASSWORD=pon-una-contrasena-fuerte

# Opcional: duración de la sesión en segundos (por defecto 12 h).
TOKEN_TTL_SECONDS=43200
